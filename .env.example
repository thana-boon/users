# =============================================================
# SchoolOS - Student & Teacher Records  ·  environment sample
# Copy to `.env` and fill real values. NEVER commit the real .env.
# =============================================================

# --- Database (PostgreSQL) ---
# This stack does NOT run a Postgres of its own. It connects to the school's
# existing `postgres-core` container over the external `school-net` network,
# as the per-module role/database `users`.
#
# Used by every compose service. Host = the DB container name on school-net.
# Compose aborts if it is unset — there is no default.
DATABASE_URL_INTERNAL="postgres://users:THE_USERS_ROLE_PASSWORD@postgres-core:5432/users"
# Used only when running `npm run dev` on the host (outside compose), via the
# port postgres-core publishes.
DATABASE_URL="postgres://users:THE_USERS_ROLE_PASSWORD@localhost:5432/users"

# --- Field encryption (AES-256-GCM) ---
# 32-byte key, base64-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# CRITICAL: this key lives OUTSIDE the database. If leaked, every stored
# password / citizen_id / income can be decrypted. Rotate via re-encrypt.
FIELD_ENCRYPTION_KEY="REPLACE_WITH_BASE64_32_BYTE_KEY"

# --- Session JWT (schoolos_token cookie, HS256) ---
# This app signs its own session token on local login (teacher-login /
# student-login) and sets the `schoolos_token` cookie; middleware verifies it.
# No external SSO — JWT_SECRET only needs to be a long random secret for THIS app.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="REPLACE_WITH_LONG_RANDOM_SECRET"
# Session timeout, in two parts.
#   SESSION_IDLE_MINUTES  — no activity for this long and you are logged out.
#                           Any request slides it forward, and the browser warns
#                           2 minutes before with an "อยู่ต่อ" button, so working
#                           in the module keeps it alive indefinitely.
#   SESSION_ABSOLUTE_HOURS — hard cap measured from the ORIGINAL login. Nothing
#                           extends this; when it lands you log in again.
# (These replaced JWT_EXPIRES_IN, which was a single fixed 8h with no idle
# timeout at all — a browser left open stayed logged in for the whole day.)
SESSION_IDLE_MINUTES="15"
SESSION_ABSOLUTE_HOURS="8"
# The session cookies carry NO max-age on purpose: closing the browser signs the
# user out, however few minutes have passed. On a shared staffroom machine the
# next person to open the browser must not inherit the last one's account. Both
# timeouts above are enforced from the token's own claims on every request, so
# nothing rests on what the browser chooses to keep.
#
# Where a signed-out / timed-out browser is sent. Also the fallback for
# GET /api/auth/logout when no `next=` is given.
# NOTE: middleware runs in the edge runtime, where Next inlines process.env at
# BUILD time — setting this in .env alone will NOT reach middleware. The default
# baked into src/lib/platform.ts is the real production portal, so leave this
# unset unless you are pointing a deployment somewhere else (and then rebuild).
PLATFORM_HOME_URL="https://schoolos.sukhon.ac.th/"
# Set the `Secure` flag on the session cookie. Secure-by-DEFAULT (true) so the
# token is never sent in the clear over HTTPS. Set to false ONLY for a plain-HTTP
# LAN deploy (e.g. http://192.168.x.x:3002) — otherwise the browser drops the
# cookie and login "succeeds" but never redirects. Never false on HTTPS/internet.
COOKIE_SECURE="true"

# --- SSO: which other SchoolOS services may ask "is this user logged in?" ---
# On login this app also sets an `sso_session` cookie (the same JWT). Other
# services call GET /api/auth/session with `credentials: 'include'` to check for
# a session before showing a login screen of their own.
#
# Each service runs on its own port, so those calls are cross-ORIGIN and need
# CORS. Comma-separated, EXACT origins (scheme + host + port, no path, no
# wildcard) — a credentialed response may not answer `*`, and anything not listed
# here simply gets no CORS headers and is blocked by the browser.
# Empty (the default) = no other service may ask.
#
# NOTE these are BROWSER origins — where the user's tab is — not where the
# service runs server-side. Add every port you actually serve a UI on.
SSO_ALLOWED_ORIGINS="http://localhost:3017"
# e.g. with the rest of the platform on this machine:
#   SSO_ALLOWED_ORIGINS="http://localhost:3017,http://localhost:3018,http://localhost:3019"
#
# The cookie is SameSite=Lax, which is per-SITE and ignores the port: different
# ports on `localhost` (or on one school domain) count as the same site, so it is
# sent on these calls. If a service ever moves to a genuinely DIFFERENT domain,
# Lax stops sending it and the cookie has to become `SameSite=None; Secure`,
# which requires HTTPS everywhere (see sessionCookieOptions in src/lib/jwt.ts).

# Number of trusted reverse proxies in front of this app. Used to pick the real
# client IP from X-Forwarded-For (counted from the RIGHT) so a caller cannot
# forge it to poison audit logs / bypass per-IP rate limiting. 1 = one gateway
# (the deployed default). Set 0 if the app is directly exposed (no proxy).
TRUSTED_PROXY_COUNT="1"

# Email domain used to generate student login emails from student_code.
STUDENT_EMAIL_DOMAIN="sukhon.ac.th"

# --- Bootstrap admin login ---
# The app creates this teacher_code as a teacher-admin at startup, but ONLY when
# the database holds no active teacher-admin at all (fresh server). Once any
# admin exists these are ignored, so a password changed in the UI survives a
# redeploy. NAME is optional. Change the password after the first login — it is
# stored encrypted, but this file holds it in plaintext.
SEED_ADMIN_CODE="T00001"
SEED_ADMIN_PASSWORD="CHOOSE_A_STRONG_ADMIN_PASSWORD"
SEED_ADMIN_NAME="ผู้ดูแล ระบบ"

# --- Database backup & restore (/users/backups) ---
# The app takes a pg_dump of the whole database every night and keeps a rolling
# window of them. Manual backup, download, upload and restore all live on the
# same page. pg_dump/pg_restore ship inside the image (see Dockerfile).
#
# WHERE THE FILES GO. BACKUP_DIR is the path INSIDE the container; docker-compose
# bind-mounts BACKUP_DIR_HOST over it, so the dumps land on the server's own disk
# and survive the container being rebuilt or removed. Point BACKUP_DIR_HOST at a
# larger disk if the default folder is tight.
BACKUP_DIR_HOST="./backups"
BACKUP_DIR="/app/backups"
# Nightly run. BACKUP_TZ matters because the container clock is UTC and midnight
# has to mean midnight locally. Set BACKUP_SCHEDULE=off to disable the nightly
# run entirely (the manual button still works).
BACKUP_SCHEDULE="on"
BACKUP_TIME="00:00"
BACKUP_TZ="Asia/Bangkok"
# How many nightly backups to keep. The 15th night deletes the oldest, so this is
# also "how many days back you can go". Manual backups, pre-restore safety copies
# and uploaded files are counted separately and are not evicted by this.
BACKUP_KEEP="14"
#BACKUP_KEEP_MANUAL="14"
#BACKUP_KEEP_PRERESTORE="5"
# Ceiling for a dump uploaded through the browser, in MB.
#BACKUP_MAX_UPLOAD_MB="2048"
